# --- LLM (set provider to "none" for fully deterministic, offline mode) ---
LLM_PROVIDER=anthropic          # anthropic | openai | none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Infra (docker-compose overrides these) ---
DATABASE_URL=postgresql+psycopg2://ads:ads@localhost:5432/ads
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=agentic-data-scientist
DATA_DIR=./data
MAX_UPLOAD_MB=50
